# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel
.vercel-*/

# supabase dumps (DB 덤프 - 계정/설정 등 포함)
supabase/dumps/

# claude code
.claude/
CLAUDE.md

# IDE
.idea/
.vscode/

# vitepress
docs/.vitepress/cache/
docs/.vitepress/dist/


# supabase temp
supabase/.temp/

# local scripts (contain secrets or personal config)
start.sh
copy-prod-to-dev.js
use-env.sh

# typescript
*.tsbuildinfo
next-env.d.ts
docs_config/

# backups
backups/

# classification scripts: 중간 산출물·파이썬 캐시
scripts/classification/data/
__pycache__/

# blog 원본 사진 (아이 이름 등 개인정보 포함 → 공개 저장소에 올리지 않음)
docs/blog/*.jpeg
docs/blog/images/*.png
